          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DATE(p.date_prix_maj) AS date_jour , c.nom_carburant ,\nROUND(AVG(p.prix_carburant), 3) AS prix_moyen,\nCOUNT(DISTINCT p.id_station) AS total_stations_vendent \nFROM prix p \nJOIN carburant c ON p.id_carburant = c.id_carburant\nGROUP BY DATE(p.date_prix_maj), c.nom_carburant\nORDER BY date_jour ASC ; ",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Évolution d'achat des carburants",
      "type": "timeseries"
