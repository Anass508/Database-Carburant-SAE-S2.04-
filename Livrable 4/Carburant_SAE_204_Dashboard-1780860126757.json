          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT \n    s.id_station,\n    s.nom_ville,\n    s.latitude,\n    s.longitude,\n    MAX(CASE WHEN c.nom_carburant = 'Gazole' THEN p.prix_carburant END) AS prix_gazole,\n    MAX(CASE WHEN c.nom_carburant = 'SP95' THEN p.prix_carburant END) AS prix_sp95,\n    MAX(CASE WHEN c.nom_carburant = 'SP98' THEN p.prix_carburant END) AS prix_sp98,\n    MAX(CASE WHEN c.nom_carburant = 'E10' THEN p.prix_carburant END) AS prix_e10,\n    MAX(CASE WHEN c.nom_carburant = 'E85' THEN p.prix_carburant END) AS prix_e85,\n    MAX(CASE WHEN c.nom_carburant = 'GPLC' THEN p.prix_carburant END) AS prix_gplc\nFROM station s\nJOIN prix p ON s.id_station = p.id_station\nJOIN carburant c ON p.id_carburant = c.id_carburant\nGROUP BY s.id_station, s.nom_ville, s.latitude, s.longitude;\n",
          "refId": "A",
          "sql": {
